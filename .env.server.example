# Sovereign AV Business OS — self-hosted server environment contract
# Copy to a secret-managed environment on the server. Never commit real values.

NODE_ENV=production
APP_ENV=production

# Canonical database connection used by server-side services only.
DATABASE_URL=postgresql://dosa_app:CHANGE_ME@postgres:5432/dosa_os
DATABASE_SSL_MODE=prefer

# Separate maintenance credentials are recommended for migrations/backups.
DB_ADMIN_URL=postgresql://postgres:CHANGE_ME@postgres:5432/dosa_os
DB_BACKUP_DIR=/var/backups/dosa-os
DB_BACKUP_RETENTION_DAYS=14

# Public product identity.
PUBLIC_APP_URL=https://example.com
DEFAULT_TENANT_SLUG=dos-a
DEFAULT_LOCALE=es-MX
DEFAULT_TIMEZONE=America/Mexico_City
DEFAULT_CURRENCY=MXN

# Runtime secrets. Generate unique high-entropy values in the server secret store.
SESSION_SECRET=CHANGE_ME
INTERNAL_API_TOKEN=CHANGE_ME
AGENT_SIGNING_SECRET=CHANGE_ME

# Optional integrations remain disabled until explicitly configured.
EMAIL_PROVIDER=disabled
WHATSAPP_PROVIDER=disabled
AI_PROVIDER=disabled
